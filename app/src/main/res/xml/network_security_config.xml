<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to ViaggiaTreno (HTTP only) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">viaggiatreno.it</domain>
        <domain includeSubdomains="true">www.viaggiatreno.it</domain>
    </domain-config>
    <!-- RFI uses HTTPS, so this is fine without extra config -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
